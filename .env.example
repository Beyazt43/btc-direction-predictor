cat > .env.example << 'EOF'
# Database
POSTGRES_USER=btcpred
POSTGRES_PASSWORD=changeme
POSTGRES_DB=btcpred
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Binance (public endpoints need no key, but keep the slot)
BINANCE_BASE_URL=https://api.binance.com
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVAL=1h

# Scheduler
INGEST_INTERVAL_MINUTES=10
RETRAIN_CRON=0 2 * * *

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
EOF
