cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env & secrets
.env
.env.local
*.pem

# Data & models — never commit these
data/
*.csv
*.parquet
models/*.pkl
models/*.joblib
models/*.json
mlruns/

# Notebooks
.ipynb_checkpoints/

# Docker/Postgres local volumes
pgdata/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
EOF
heartbeat
migrate/

# Local backups of the live record
backups/

# Database dumps (the host-migration runbook copies one into the repo root)
*.sql

# Watchdog maintenance switch (scripts/watchdog.ps1)
.watchdog-disabled
